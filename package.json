{
  "name": "console-capture-viewer",
  "productName": "Console Capture Viewer",
  "version": "1.0.0",
  "description": "Play your console on your PC using a USB capture card.",
  "main": "src/main.js",
  "author": "Console Capture Viewer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.consolecaptureviewer.app",
    "productName": "Console Capture Viewer",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
