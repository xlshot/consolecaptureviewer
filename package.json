{
  "name": "console-capture-viewer",
  "productName": "Console Capture Viewer",
  "version": "1.0.1",
  "description": "Play your console on your PC using a USB capture card.",
  "main": "src/main.js",
  "author": "Console Capture Viewer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "build": {
    "appId": "com.consolecaptureviewer.app",
    "productName": "Console Capture Viewer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Console-Capture-Viewer-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xlshot",
        "repo": "consolecaptureviewer"
      }
    ],
    "portable": {
      "artifactName": "Console-Capture-Viewer-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
